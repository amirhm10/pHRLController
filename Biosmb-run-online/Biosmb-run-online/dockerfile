FROM python:3.11-slim

WORKDIR /app

# I changed this line: use the same PyTorch release as the selected 500000-step checkpoint.
ARG PYTORCH_VERSION=2.8.0

# I changed this line: show Python logs immediately and avoid copying runtime bytecode into the shared project folder.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY requirements.txt ./

# I changed this line: install CPU-only PyTorch because online BioSMB training runs on the CPU.
RUN python -m pip install --no-cache-dir \
        "torch==${PYTORCH_VERSION}" \
        --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip check

COPY . .

# I changed this line: keep controller output unbuffered so Docker shows each online TD3 and safety message immediately.
CMD ["python", "-u", "./main.py"]

# CMD ["python", "./main_deploy.py"]
